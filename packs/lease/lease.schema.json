{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Residential lease terms (extracted)",
  "description": "Every field is the value stated in the lease, or null when the lease does not state it. Never infer a value the text does not give.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id",
    "synthetic",
    "monthly_rent",
    "rent_changes",
    "security_deposit",
    "lease_start",
    "lease_end",
    "term_months",
    "rent_due_day",
    "late_fee",
    "pets_allowed",
    "pet_deposit",
    "utilities_included",
    "renewal_notice_days",
    "early_termination_fee",
    "flags"
  ],
  "properties": {
    "lease_id": {
      "type": "string",
      "pattern": "^SYN-L[0-9]{2}$"
    },
    "synthetic": {
      "const": true
    },
    "monthly_rent": {
      "type": [
        "number",
        "null"
      ]
    },
    "rent_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effective",
          "monthly_rent"
        ],
        "properties": {
          "effective": {
            "type": "string",
            "format": "date"
          },
          "monthly_rent": {
            "type": "number"
          }
        }
      }
    },
    "security_deposit": {
      "type": [
        "number",
        "null"
      ]
    },
    "lease_start": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "lease_end": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "term_months": {
      "type": [
        "integer",
        "null"
      ]
    },
    "rent_due_day": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 31
    },
    "late_fee": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "amount",
        "grace_days"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "grace_days": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "pets_allowed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "pet_deposit": {
      "type": [
        "number",
        "null"
      ]
    },
    "utilities_included": {
      "type": "array",
      "items": {
        "enum": [
          "water",
          "sewer",
          "trash",
          "gas",
          "electric",
          "internet"
        ]
      }
    },
    "renewal_notice_days": {
      "type": [
        "integer",
        "null"
      ]
    },
    "early_termination_fee": {
      "type": [
        "number",
        "null"
      ]
    },
    "flags": {
      "type": "array",
      "items": {
        "enum": [
          "instructions_in_document",
          "conflicting_terms",
          "handwritten_change"
        ]
      }
    }
  }
}
