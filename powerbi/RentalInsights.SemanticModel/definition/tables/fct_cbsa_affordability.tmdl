table fct_cbsa_affordability
	lineageTag: af728275-89c0-5f4b-bc87-d41938a02d8f

	measure 'CBSA count' = COUNTROWS(fct_cbsa_affordability)
		formatString: #,0
		displayFolder: Affordability
		lineageTag: 7987b31c-1d8b-56ad-a74e-9f5277583070

	measure 'K4 Median rent-burdened share' = MEDIAN(fct_cbsa_affordability[rent_burdened_share])
		formatString: 0.0%
		displayFolder: Affordability
		lineageTag: 9bb9c041-8abf-561e-9848-e5fdcc24e285

	measure 'K5 Median severely rent-burdened share' = MEDIAN(fct_cbsa_affordability[severely_rent_burdened_share])
		formatString: 0.0%
		displayFolder: Affordability
		lineageTag: 401dded2-614f-5d3c-bc46-f5a440deaadc

	measure 'K6 Median rent to income' = MEDIAN(fct_cbsa_affordability[rent_to_income])
		formatString: 0.0%
		displayFolder: Affordability
		lineageTag: a1df6646-4d05-5cba-b2e5-bad39e0f9630

	measure 'K7 Median market rent to FMR' = MEDIAN(fct_cbsa_affordability[zori_to_fmr_2br])
		formatString: 0.00
		displayFolder: Affordability
		lineageTag: 7b2af5e4-3bd8-53e9-8ee0-293a60cbfc5f

	measure 'K7 Areas with market rent and FMR' = CALCULATE(COUNTROWS(fct_cbsa_affordability), NOT ISBLANK(fct_cbsa_affordability[zori_to_fmr_2br]))
		formatString: #,0
		displayFolder: Affordability
		lineageTag: b49d6a9a-c4da-584b-97b9-1a12a4bb5a1f

	measure 'K7 Areas with market rent above FMR' = CALCULATE(COUNTROWS(fct_cbsa_affordability), fct_cbsa_affordability[zori_to_fmr_2br] > 1)
		formatString: #,0
		displayFolder: Affordability
		lineageTag: 98d846bd-0070-5fd7-b4fd-9455981f10cb

	measure 'K8 Areas where most renters are burdened' = CALCULATE(COUNTROWS(fct_cbsa_affordability), fct_cbsa_affordability[rent_burdened_share] >= 0.5)
		formatString: #,0
		displayFolder: Geography
		lineageTag: 15390cd7-917a-519c-882b-a5fa9929f35d

