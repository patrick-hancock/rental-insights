	partition fct_cbsa_affordability = m
		mode: import
		source =
				let
				    Source = GoogleBigQuery.Database([BillingProject = BigQueryProject]),
				    Project = Source{[Name = BigQueryProject]}[Data],
				    Dataset = Project{[Name = BigQueryDataset, Kind = "Schema"]}[Data],
				    Gold = Dataset{[Name = "fct_cbsa_affordability", Kind = "Table"]}[Data],
				    Kept = Table.SelectColumns(Gold, {"cbsa_code", "cbsa_name", "cbsa_type", "population", "rent_burdened_share", "severely_rent_burdened_share", "rent_to_income", "hud_fmr_2br_weighted", "latest_zori", "zori_to_fmr_2br"})
